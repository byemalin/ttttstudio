<%# Main Navbar %>

<header id="mainNavbar">

  <%= link_to landing_path do %>
    <div id="navLogoContainer">
      <%#= image_tag "logos/TTTT_dot_logo.svg" %>
      <%= image_tag "logos/TTTT_logo_1.svg" %>
    </div>
  <% end %>


  <nav>
      <ul>

        <li><%= link_to "blog", posts_path%></li>
        <br>
        <li><%= link_to "takes", takes_path%></li>
        <% if false %>
        <br>
        <li><%= link_to "store", posts_path%></li>
        <br>
        <li><%= link_to "radio", posts_path%></li>
        <% end %>
        <% unless user_signed_in? %>
          <br>
          <%= link_to 'log in', new_user_session_path %>
        <% end %>
      </ul>
  </nav>


</header>

<nav id="teamNav">
  <br>
  <br>
  <br>
  <ul>
    <li><%= link_to "Ezra", posts_user_path(@ezra_user)%></li>
    <br>
    <li><%= link_to "Malin", posts_user_path(@malin_user)%></li>
    <br>
    <li><%= link_to "Rocco", posts_user_path(@rocco_user)%></li>
  </ul>
</nav>

<% if user_signed_in? %>
  <nav class="postingControls">
    <br>
    <p>Welcome, <%= current_user.name %></p>
    <p><strong>Only the gang can see this section.</strong></p>
    <%= link_to "New Take", new_take_path %>
    <p><%= link_to 'New Blog Post', new_post_path %></p>
    <br>
  </nav>
<% end %>
