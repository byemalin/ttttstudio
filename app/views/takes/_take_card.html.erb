<%= link_to take_path(take) do %>
<% end %>

<div class='takeCard'>
  <p><%= take.body %></p>

  <% if take.photo.attached? %>
    <%= image_tag take.photo, alt: "Take photo", width: 300 %>
  <% end %>

  <footer>
    <p>
      <%= link_to "#{take.user.name}", posts_user_path(take.user) %>
    </p>

    <div>
      <% if false %>
        <p><%= link_to "Details", take_path(take) %></p>
      <% end %>
      <p><%= take.created_at.strftime("%d %b %Y %H:%M") %></p>
    </div>
  </footer>
</div>
