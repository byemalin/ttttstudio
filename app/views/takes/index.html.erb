<h1>All Takes</h1>

<% if user_signed_in? %>
  <%= link_to "New Take", new_take_path %>
<% end %>

<% @takes.each do |take| %>
  <div>
    <p><%= take.body %></p>
     <p>
      <%= link_to "#{take.user.name}", posts_user_path(take.user) %>
    </p>

    <% if take.photo.attached? %>
      <%= image_tag take.photo, alt: "Take photo", width: 300 %>
    <% end %>

    <p><%= link_to "View", take_path(take) %></p>
  </div>
  <hr>
<% end %>
