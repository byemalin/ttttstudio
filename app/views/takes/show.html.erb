<h1>Take by <%= @take.user.name %></h1>
<p><%= @take.body %></p>

<% if @take.photo.attached? %>
  <%= image_tag @take.photo, alt: "Take photo", width: 400 %>
<% end %>

<p>Posted on <%= @take.created_at.strftime("%d %b %Y at %H:%M") %></p>

<%= link_to "Back to All Takes", takes_path %>

<% if user_signed_in? %>
  <br>
  <br>
  <p>As usual, only da gang can see these edit controls:</p>
  <%= link_to "Edit Take", edit_take_path(@take) %> |
  <%= link_to "Delete", take_path(@take), method: :delete, data: { confirm: "Are you sure?" } %>
<% end %>
